# Application
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://sbom_user:sbom_pass@postgres:5432/sbom_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# Redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SBOM Processing
MAX_SBOM_SIZE_MB=50
MAX_COMPONENTS_PER_SBOM=50000
SBOM_SIGNATURE_REQUIRED=False

# Vulnerability Feeds
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
OSV_API_URL=https://api.osv.dev/v1
GITHUB_API_URL=https://api.github.com/advisories
GITHUB_TOKEN=

# Risk Scoring Weights
VULNERABILITY_WEIGHT=0.40
LICENSE_RISK_WEIGHT=0.20
SIGNING_WEIGHT=0.20
MAINTAINER_HEALTH_WEIGHT=0.10
DEPENDENCY_DEPTH_WEIGHT=0.10

# Thresholds
CRITICAL_RISK_THRESHOLD=8.0
HIGH_RISK_THRESHOLD=6.0
MEDIUM_RISK_THRESHOLD=4.0

# Compliance
SLSA_LEVEL_REQUIRED=3
NTIA_VALIDATION_ENABLED=True

# Performance
SCAN_TIMEOUT_SECONDS=300
MAX_CONCURRENT_SCANS=10
