# Application Configuration
APP_NAME=threat-hunting-platform
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threat_hunting
POSTGRES_USER=threat_hunter
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# TimescaleDB (PostgreSQL extension)
TIMESCALEDB_ENABLED=true

# InfluxDB Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=REPLACE_WITH_INFLUXDB_TOKEN
INFLUXDB_ORG=threat-hunting
INFLUXDB_BUCKET=behavioral_metrics

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=security-events
KAFKA_TOPIC_ANOMALIES=anomalies
KAFKA_TOPIC_LEADS=threat-leads
KAFKA_CONSUMER_GROUP=threat-hunting-platform

# Machine Learning Configuration
ML_MODEL_PATH=models/trained
ML_BASELINE_PATH=models/baselines
ML_RETRAIN_INTERVAL_HOURS=24
ML_ANOMALY_THRESHOLD=0.95
ML_ENSEMBLE_VOTING_STRATEGY=weighted  # Options: majority, weighted, unanimous

# Behavioral Analytics
UEBA_ENABLED=true
UEBA_BASELINE_DAYS=30
UEBA_MIN_EVENTS_FOR_PROFILE=100
UEBA_FEATURE_COUNT=200

# Threat Intelligence
MISP_URL=https://misp.example.com
MISP_API_KEY=REPLACE_WITH_MISP_API_KEY
MISP_VERIFY_SSL=true
ATTACK_FRAMEWORK_PATH=data/attack/enterprise-attack.json

# API Security
API_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY  # Generate with: openssl rand -hex 32
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_RATE_LIMIT_PER_MINUTE=100

# Monitoring & Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
HEALTHCHECK_ENABLED=true

# Performance Tuning
MAX_WORKERS=4
BATCH_SIZE=1000
EVENT_PROCESSING_TIMEOUT=30
ANOMALY_DETECTION_INTERVAL_SECONDS=60

# Data Retention
RAW_DATA_RETENTION_DAYS=90
PROCESSED_DATA_RETENTION_DAYS=180
ANOMALY_DATA_RETENTION_DAYS=365
